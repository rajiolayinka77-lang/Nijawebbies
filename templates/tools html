<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Digital Tools - NijaWebbies</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7f5;
            color: #17201b;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* =========================
           NAVIGATION
        ========================= */

        .navbar {
            background: #ffffff;
            border-bottom: 1px solid #e3e8e5;
            padding: 14px 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: #087f5b;
            white-space: nowrap;
        }

        .nav-links {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
        }

        .nav-links a {
            font-size: 14px;
            font-weight: 600;
            color: #35423a;
            padding: 8px 10px;
            border-radius: 8px;
        }

        .nav-links a:hover {
            background: #edf7f2;
            color: #087f5b;
        }

        .notification-link {
            display: inline-flex !important;
            align-items: center;
            gap: 6px;
        }

        .notification-badge {
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            border-radius: 999px;
            background: #dc2626;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            background: linear-gradient(
                135deg,
                #087f5b,
                #0b9b70
            );
            color: #ffffff;
            padding: 65px 20px;
            text-align: center;
        }

        .hero h1 {
            margin: 0 0 15px;
            font-size: 42px;
        }

        .hero p {
            max-width: 760px;
            margin: 0 auto;
            font-size: 18px;
            line-height: 1.7;
            opacity: 0.96;
        }

        .hero-badge {
            display: inline-block;
            margin-bottom: 18px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.16);
            font-size: 13px;
            font-weight: 700;
        }

        /* =========================
           MAIN
        ========================= */

        .container {
            width: 92%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section {
            padding: 45px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 10px;
            font-size: 30px;
        }

        .section-subtitle {
            text-align: center;
            color: #68736d;
            max-width: 700px;
            margin: 0 auto 30px;
            line-height: 1.6;
        }

        /* =========================
           AI TOOLS
        ========================= */

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(
                3,
                minmax(0, 1fr)
            );
            gap: 22px;
        }

        .tool-card {
            background: #ffffff;
            border: 1px solid #e1e8e4;
            border-radius: 18px;
            padding: 26px;
            box-shadow: 0 8px 25px rgba(
                0,
                0,
                0,
                0.05
            );
            transition: transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .tool-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(
                0,
                0,
                0,
                0.08
            );
        }

        .tool-icon {
            width: 58px;
            height: 58px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 29px;
            background: #eaf7f1;
            margin-bottom: 18px;
        }

        .tool-card h3 {
            margin: 0 0 10px;
            font-size: 21px;
        }

        .tool-card p {
            color: #68736d;
            line-height: 1.6;
            min-height: 70px;
            margin-bottom: 20px;
        }

        .tool-button {
            display: inline-block;
            width: 100%;
            text-align: center;
            padding: 12px 16px;
            border: none;
            border-radius: 10px;
            background: #087f5b;
            color: #ffffff;
            font-weight: 700;
            cursor: pointer;
            font-size: 14px;
        }

        .tool-button:hover {
            background: #066b4d;
        }

        .coming-button {
            background: #e8ecea;
            color: #59635d;
            cursor: default;
        }

        .coming-button:hover {
            background: #e8ecea;
        }

        /* =========================
           AI CREATOR PANEL
        ========================= */

        .creator-panel {
            margin-top: 35px;
            background: #ffffff;
            border: 1px solid #e1e8e4;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 8px 25px rgba(
                0,
                0,
                0,
                0.04
            );
        }

        .creator-panel h3 {
            margin-top: 0;
            font-size: 23px;
        }

        .creator-panel p {
            color: #68736d;
            line-height: 1.6;
        }

        .prompt-box {
            width: 100%;
            min-height: 120px;
            padding: 15px;
            border: 1px solid #ccd6d1;
            border-radius: 10px;
            resize: vertical;
            font-family: inherit;
            font-size: 15px;
            outline: none;
        }

        .prompt-box:focus {
            border-color: #087f5b;
            box-shadow: 0 0 0 3px rgba(
                8,
                127,
                91,
                0.1
            );
        }

        .creator-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .creator-actions button {
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            font-weight: 700;
            cursor: pointer;
        }

        .generate-button {
            background: #087f5b;
            color: #ffffff;
        }

        .generate-button:hover {
            background: #066b4d;
        }

        .clear-button {
            background: #edf1ef;
            color: #34413a;
        }

        .result-box {
            display: none;
            margin-top: 25px;
            padding: 20px;
            border-radius: 12px;
            background: #f4f8f6;
            border: 1px solid #dce7e1;
        }

        .result-box.show {
            display: block;
        }

        .result-box strong {
            display: block;
            margin-bottom: 8px;
        }

        /* =========================
           EVERYDAY TOOLS
        ========================= */

        .small-tools {
            display: grid;
            grid-template-columns: repeat(
                4,
                minmax(0, 1fr)
            );
            gap: 16px;
        }

        .small-tool {
            background: #ffffff;
            border: 1px solid #e1e8e4;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
        }

        .small-tool-icon {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .small-tool h4 {
            margin: 0 0 8px;
        }

        .small-tool p {
            margin: 0;
            color: #68736d;
            font-size: 13px;
            line-height: 1.5;
        }

        /* =========================
           INFO
        ========================= */

        .info-section {
            padding: 10px 0 55px;
        }

        .info-box {
            background: #eaf7f1;
            border: 1px solid #cfe9dd;
            border-radius: 16px;
            padding: 25px;
            text-align: center;
        }

        .info-box h3 {
            margin-top: 0;
            color: #075f45;
        }

        .info-box p {
            margin-bottom: 0;
            color: #405249;
            line-height: 1.6;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #14221b;
            color: #dce7e1;
            padding: 35px 20px;
            margin-top: 20px;
        }

        .footer-inner {
            max-width: 1200px;
            width: 92%;
            margin: auto;
            text-align: center;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 18px;
            margin-bottom: 18px;
        }

        .footer-links a {
            color: #dce7e1;
            font-size: 14px;
        }

        .footer-links a:hover {
            color: #ffffff;
        }

        .footer-inner p {
            margin: 0;
            font-size: 13px;
            color: #aab8b0;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 950px) {

            .tools-grid {
                grid-template-columns: repeat(
                    2,
                    minmax(0, 1fr)
                );
            }

            .small-tools {
                grid-template-columns: repeat(
                    2,
                    minmax(0, 1fr)
                );
            }

        }

        @media (max-width: 700px) {

            .navbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .nav-links {
                width: 100%;
                justify-content: flex-start;
            }

            .hero {
                padding: 45px 18px;
            }

            .hero h1 {
                font-size: 32px;
            }

            .hero p {
                font-size: 16px;
            }

            .tools-grid {
                grid-template-columns: 1fr;
            }

            .small-tools {
                grid-template-columns: 1fr;
            }

            .section-title {
                font-size: 26px;
            }

        }

    </style>

</head>


