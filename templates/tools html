<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

let currentGenerator = null;


function openGenerator(type) {

    currentGenerator = type;

    const title =
        document.getElementById("creatorTitle");

    const description =
        document.getElementById("creatorDescription");

    const prompt =
        document.getElementById("creatorPrompt");

    const panel =
        document.getElementById("creatorPanel");

    const resultBox =
        document.getElementById("resultBox");


    resultBox.classList.remove("show");


    if (type === "image") {

        title.textContent =
            "🖼️ AI Image Generator";

        description.textContent =
            "Describe the image you want to create.";

        prompt.placeholder =
            "Example: A beautiful Lagos street at sunset, cinematic photography...";

    }


    else if (type === "video") {

        title.textContent =
            "🎬 AI Video Generator";

        description.textContent =
            "Describe the video you want to create.";

        prompt.placeholder =
            "Example: A young Nigerian entrepreneur opening a modern shop in Lagos...";

    }


    else if (type === "music") {

        title.textContent =
            "🎵 AI Music Generator";

        description.textContent =
            "Describe the music you want to create.";

        prompt.placeholder =
            "Example: An energetic Afrobeat instrumental for a business advertisement...";

    }


    panel.scrollIntoView({
        behavior: "smooth",
        block: "start"
    });

}


function startGeneration() {

    const prompt =
        document.getElementById("creatorPrompt");

    const resultBox =
        document.getElementById("resultBox");

    const resultMessage =
        document.getElementById("resultMessage");


    const text =
        prompt.value.trim();


    if (!currentGenerator) {

        alert(
            "Please choose an AI creation tool first."
        );

        return;

    }


    if (!text) {

        alert(
            "Please describe what you want to create."
        );

        prompt.focus();

        return;

    }


    let toolName = "AI Creator";


    if (currentGenerator === "image") {
        toolName = "AI Image Generator";
    }

    if (currentGenerator === "video") {
        toolName = "AI Video Generator";
    }

    if (currentGenerator === "music") {
        toolName = "AI Music Generator";
    }


    resultMessage.textContent =
        toolName +
        " is ready for connection to the AI generation service. " +
        "Your prompt has been prepared successfully.";


    resultBox.classList.add("show");


    resultBox.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
    });

}


function clearGenerator() {

    document.getElementById(
        "creatorPrompt"
    ).value = "";

    document.getElementById(
        "resultBox"
    ).classList.remove("show");

}


/* =====================================================
   GLOBAL NOTIFICATION COUNT
===================================================== */

{% if session.get("user_id") %}

async function updateGlobalNotificationCount() {

    try {

        const response = await fetch(
            "{{ url_for('notification_count') }}",
            {
                method: "GET",
                credentials: "same-origin",
                cache: "no-store"
            }
        );


        if (!response.ok) {
            return;
        }


        const data =
            await response.json();


        const badge =
            document.getElementById(
                "globalNotificationBadge"
            );


        if (!badge) {
            return;
        }


        const count =
            Number(data.count || 0);


        if (count > 0) {

            badge.textContent =
                count;

            badge.style.display =
                "inline-flex";

        }

        else {

            badge.textContent =
                "";

            badge.style.display =
                "none";

        }

    }

    catch (error) {

        console.log(
            "Notification count update skipped."
        );

    }

}


updateGlobalNotificationCount();


setInterval(
    updateGlobalNotificationCount,
    30000
);

{% endif %}

</script>


