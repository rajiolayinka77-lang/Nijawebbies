<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ business.business_name or "Business Profile" }} | NijaWebbies</title>

    <meta name="description"
          content="{{ business.description or 'Business profile on NijaWebbies' }}">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #222;
        }

        .topbar {
            background: #111827;
            color: white;
            padding: 16px 20px;
            text-align: center;
        }

        .brand {
            font-size: 22px;
            font-weight: bold;
        }

        .container {
            max-width: 850px;
            margin: 30px auto;
            padding: 0 16px;
        }

        .card {
            background: white;
            border-radius: 18px;
            padding: 28px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        .business-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .business-logo {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            background: #e5e7eb;
            margin-bottom: 15px;
        }

        .business-name {
            font-size: 30px;
            margin: 5px 0;
            color: #111827;
        }

        .category {
            color: #6b7280;
            font-size: 16px;
        }

        .verified {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 12px;
            border-radius: 20px;
            background: #e8f5e9;
            color: #15803d;
            font-size: 13px;
            font-weight: bold;
        }

        .section {
            margin-top: 28px;
        }

        .section h2 {
            font-size: 20px;
            margin-bottom: 10px;
            color: #111827;
        }

        .description {
            line-height: 1.7;
            color: #4b5563;
            white-space: pre-line;
        }

        .info {
            display: grid;
            gap: 12px;
        }

        .info-row {
            padding: 14px;
            background: #f9fafb;
            border-radius: 10px;
        }

        .info-label {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 16px;
            color: #111827;
            word-break: break-word;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 25px;
            justify-content: center;
        }

        .btn {
            display: inline-block;
            text-decoration: none;
            padding: 13px 18px;
            border-radius: 10px;
            font-weight: bold;
            text-align: center;
        }

        .btn-phone {
            background: #16a34a;
            color: white;
        }

        .btn-whatsapp {
            background: #25d366;
            color: white;
        }

        .btn-website {
            background: #2563eb;
            color: white;
        }

        .footer {
            text-align: center;
            color: #6b7280;
            font-size: 13px;
            margin: 25px 0;
        }

        .footer a {
            color: #2563eb;
            text-decoration: none;
        }

        @media (max-width: 600px) {
            .container {
                margin: 15px auto;
            }

            .card {
                padding: 20px;
            }

            .business-name {
                font-size: 25px;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="topbar">
    <div class="brand">🇳🇬 NijaWebbies</div>
</div>

<div class="container">

    <div class="card">

        <div class="business-header">

            {% if business.logo_url %}
                <img
                    src="{{ business.logo_url }}"
                    alt="{{ business.business_name or 'Business Logo' }}"
                    class="business-logo"
                >
            {% else %}
                <div
                    class="business-logo"
                    style="display:flex;align-items:center;justify-content:center;
                           font-size:45px;margin-left:auto;margin-right:auto;"
                >
                    🏪
                </div>
            {% endif %}

            <h1 class="business-name">
                {{ business.business_name or "Business Profile" }}
            </h1>

            {% if business.category %}
                <div class="category">
                    {{ business.category }}
                </div>
            {% endif %}

            <div class="verified">
                ✓ NijaWebbies Business Profile
            </div>

        </div>


        {% if business.description %}
        <div class="section">
            <h2>About the Business</h2>

            <div class="description">
                {{ business.description }}
            </div>
        </div>
        {% endif %}


        <div class="section">
            <h2>Business Information</h2>

            <div class="info">

                {% if business.address %}
                <div class="info-row">
                    <div class="info-label">📍 Address</div>
                    <div class="info-value">
                        {{ business.address }}
                    </div>
                </div>
                {% endif %}


                {% if business.phone %}
                <div class="info-row">
                    <div class="info-label">📞 Phone</div>
                    <div class="info-value">
                        {{ business.phone }}
                    </div>
                </div>
                {% endif %}


                {% if business.email %}
                <div class="info-row">
                    <div class="info-label">✉️ Email</div>
                    <div class="info-value">
                        {{ business.email }}
                    </div>
                </div>
                {% endif %}


                {% if business.website %}
                <div class="info-row">
                    <div class="info-label">🌐 Website</div>
                    <div class="info-value">
                        {{ business.website }}
                    </div>
                </div>
                {% endif %}

            </div>
        </div>


        <div class="actions">

            {% if phone_link %}
            <a href="{{ phone_link }}" class="btn btn-phone">
                📞 Call Business
            </a>
            {% elif business.phone %}
            <a href="tel:{{ business.phone }}" class="btn btn-phone">
                📞 Call Business
            </a>
            {% endif %}


            {% if business.phone %}
            <a
                href="https://wa.me/{{ business.phone|replace('+','')|replace(' ','')|replace('-','') }}"
                class="btn btn-whatsapp"
                target="_blank"
                rel="noopener"
            >
                💬 WhatsApp
            </a>
            {% endif %}


            {% if business.website %}
            <a
                href="{{ business.website }}"
                class="btn btn-website"
                target="_blank"
                rel="noopener"
            >
                🌐 Visit Website
            </a>
            {% endif %}

        </div>

    </div>


    <div class="footer">
        Powered by
        <a href="{{ url_for('home') }}">NijaWebbies</a>
        🇳🇬
    </div>

</div>

</body>
          </html>
