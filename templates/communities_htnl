<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Communities | NijaWebbies</title>

    <meta name="description"
          content="Create, discover and join communities on NijaWebbies.">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7f6;
            color: #17211b;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .topbar {
            background: #087443;
            color: white;
            padding: 14px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav {
            max-width: 1150px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            font-size: 22px;
            font-weight: 800;
            white-space: nowrap;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .nav-links a {
            padding: 8px 11px;
            border-radius: 8px;
            font-size: 14px;
        }

        .nav-links a:hover {
            background: rgba(255,255,255,0.15);
        }

        .nav-links .active {
            background: white;
            color: #087443;
            font-weight: 700;
        }

        .container {
            max-width: 1150px;
            margin: 0 auto;
            padding: 28px 18px 50px;
        }

        .hero {
            background: white;
            border-radius: 18px;
            padding: 30px;
            margin-bottom: 24px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.05);
        }

        .hero h1 {
            margin: 0 0 10px;
            font-size: 32px;
        }

        .hero p {
            margin: 0;
            color: #5c675f;
            line-height: 1.6;
            max-width: 750px;
        }

        .welcome {
            margin-top: 12px;
            color: #087443;
            font-weight: 700;
        }

        .layout {
            display: grid;
            grid-template-columns: 330px 1fr;
            gap: 24px;
            align-items: start;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.05);
        }

        .card h2 {
            margin: 0 0 16px;
            font-size: 21px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: 700;
            font-size: 14px;
        }

        input,
        textarea,
        select {
            width: 100%;
            border: 1px solid #d5ddd8;
            border-radius: 9px;
            padding: 11px 12px;
            font-size: 15px;
            font-family: inherit;
            outline: none;
            background: white;
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: #087443;
            box-shadow: 0 0 0 2px rgba(8,116,67,0.08);
        }

        textarea {
            min-height: 105px;
            resize: vertical;
        }

        .btn {
            display: inline-block;
            border: none;
            border-radius: 9px;
            padding: 11px 16px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
        }

        .btn-primary {
            background: #087443;
            color: white;
            width: 100%;
        }

        .btn-primary:hover {
            background: #065d36;
        }

        .btn-join {
            background: #087443;
            color: white;
        }

        .btn-join:hover {
            background: #065d36;
        }

        .btn-joined {
            background: #e8f5ed;
            color: #087443;
            cursor: default;
        }

        .section {
            margin-top: 24px;
        }

        .section:first-child {
            margin-top: 0;
        }

        .section-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 14px;
        }

        .section-title h2 {
            margin: 0;
            font-size: 23px;
        }

        .count {
            background: #e8f5ed;
            color: #087443;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .community-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .community {
            background: white;
            border-radius: 15px;
            padding: 19px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.045);
            border: 1px solid #edf1ee;
        }

        .community h3 {
            margin: 0 0 8px;
            font-size: 19px;
        }

        .community-description {
            color: #5c675f;
            line-height: 1.5;
            font-size: 14px;
            margin-bottom: 13px;
        }

        .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 14px;
        }

        .tag {
            background: #f0f4f1;
            color: #3d4942;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 12px;
        }

        .owner {
            font-size: 13px;
            color: #68736c;
            margin-bottom: 13px;
        }

        .community-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .empty {
            background: white;
            border: 1px dashed #cbd6ce;
            border-radius: 14px;
            padding: 25px;
            text-align: center;
            color: #69736d;
        }

        .flash-container {
            margin-bottom: 20px;
        }

        .flash {
            padding: 12px 15px;
            border-radius: 9px;
            margin-bottom: 9px;
            font-size: 14px;
        }

        .flash-success {
            background: #e8f7ed;
            color: #176536;
        }

        .flash-danger {
            background: #fdeaea;
            color: #9b2525;
        }

        .flash-warning {
            background: #fff5dc;
            color: #7b5a08;
        }

        .flash-info {
            background: #e8f1ff;
            color: #24558f;
        }

        footer {
            background: #10251b;
            color: #dbe8df;
            padding: 30px 18px;
            margin-top: 30px;
        }

        .footer-inner {
            max-width: 1150px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            gap: 25px;
            flex-wrap: wrap;
        }

        .footer-brand {
            font-size: 19px;
            font-weight: 800;
            color: white;
        }

        .footer-text {
            margin-top: 7px;
            color: #aebdb3;
            font-size: 14px;
        }

        .footer-links {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            font-size: 14px;
        }

        .footer-links a:hover {
            color: white;
        }

        @media (max-width: 850px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .community-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 650px) {
            .topbar {
                padding: 12px 14px;
            }

            .nav {
                align-items: flex-start;
                flex-direction: column;
            }

            .nav-links {
                justify-content: flex-start;
                width: 100%;
            }

            .nav-links a {
                font-size: 13px;
                padding: 7px 8px;
            }

            .container {
                padding: 20px 12px 40px;
            }

            .hero {
                padding: 22px;
            }

            .hero h1 {
                font-size: 27px;
            }

            .card {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

<header class="topbar">
    <div class="nav">

        <a href="{{ url_for('home') }}" class="brand">
            🇳🇬 NijaWebbies
        </a>

        <nav class="nav-links">
            <a href="{{ url_for('home') }}">Home</a>
            <a href="{{ url_for('search') }}">Search</a>
            <a href="{{ url_for('businesses') }}">Businesses</a>
            <a href="{{ url_for('communities') }}" class="active">Communities</a>
            <a href="{{ url_for('tools') }}">Tools</a>
            <a href="{{ url_for('workspace') }}">Workspace</a>
            <a href="{{ url_for('logout') }}">Logout</a>
        </nav>

    </div>
</header>


<main class="container">

    <section class="hero">

        <h1>👥 Communities</h1>

        <p>
            Create communities, discover people with shared interests,
            and build meaningful connections on NijaWebbies.
        </p>

        {% if user_name %}
            <div class="welcome">
                Welcome, {{ user_name }} 👋
            </div>
        {% endif %}

    </section>


    {% with messages = get_flashed_messages(with_categories=true) %}

        {% if messages %}

            <div class="flash-container">

                {% for category, message in messages %}

                    <div class="flash flash-{{ category }}">
                        {{ message }}
                    </div>

                {% endfor %}

            </div>

        {% endif %}

    {% endwith %}


    <div class="layout">

        <!-- CREATE COMMUNITY -->
        <aside>

            <div class="card">

                <h2>➕ Create a Community</h2>

                <form method="POST"
                      action="{{ url_for('communities') }}">

                    <div class="form-group">

                        <label for="name">
                            Community Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="e.g. Epe Entrepreneurs"
                            maxlength="150"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="category">
                            Category
                        </label>

                        <select id="category" name="category">

                            <option value="">
                                Select a category
                            </option>

                            <option value="Business">
                                Business
                            </option>

                            <option value="Entrepreneurship">
                                Entrepreneurship
                            </option>

                            <option value="Education">
                                Education
                            </option>

                            <option value="Technology">
                                Technology
                            </option>

                            <option value="Agriculture">
                                Agriculture
                            </option>

                            <option value="Creative">
                                Creative
                            </option>

                            <option value="Entertainment">
                                Entertainment
                            </option>

                            <option value="Community">
                                Community
                            </option>

                            <option value="Lifestyle">
                                Lifestyle
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="description">
                            Description
                        </label>

                        <textarea
                            id="description"
                            name="description"
                            placeholder="Tell people what your community is about..."
                            maxlength="1000"
                        ></textarea>

                    </div>


                    <button
                        type="submit"
                        class="btn btn-primary">
                        Create Community
                    </button>

                </form>

            </div>

        </aside>


        <!-- COMMUNITIES -->
        <section>

            <!-- MY COMMUNITIES -->

            <div class="section">

                <div class="section-title">

                    <h2>My Communities</h2>

                    <span class="count">
                        {{ my_communities|length }}
                    </span>

                </div>


                {% if my_communities %}

                    <div class="community-grid">

                        {% for community in my_communities %}

                            <article class="community">

                                <h3>
                                    {{ community.name }}
                                </h3>

                                {% if community.description %}

                                    <div class="community-description">
                                        {{ community.description }}
                                    </div>

                                {% else %}

                                    <div class="community-description">
                                        No description provided.
                                    </div>

                                {% endif %}


                                <div class="meta">

                                    {% if community.category %}

                                        <span class="tag">
                                            {{ community.category }}
                                        </span>

                                    {% endif %}

                                    <span class="tag">
                                        Member
                                    </span>

                                </div>


                                <div class="community-actions">

                                    <span class="tag">
                                        ✓ Joined
                                    </span>

                                </div>

                            </article>

                        {% endfor %}

                    </div>

                {% else %}

                    <div class="empty">

                        <strong>
                            You have not joined any communities yet.
                        </strong>

                        <p>
                            Discover a community below or create your own.
                        </p>

                    </div>

                {% endif %}

            </div>


            <!-- DISCOVER COMMUNITIES -->

            <div class="section">

                <div class="section-title">

                    <h2>Discover Communities</h2>

                    <span class="count">
                        {{ communities|length }}
                    </span>

                </div>


                {% if communities %}

                    <div class="community-grid">

                        {% for community in communities %}

                            {% set ns = namespace(joined=false) %}

                            {% for mine in my_communities %}

                                {% if mine.id == community.id %}

                                    {% set ns.joined = true %}

                                {% endif %}

                            {% endfor %}


                            <article class="community">

                                <h3>
                                    {{ community.name }}
                                </h3>


                                {% if community.description %}

                                    <div class="community-description">
                                        {{ community.description }}
                                    </div>

                                {% else %}

                                    <div class="community-description">
                                        No description provided.
                                    </div>

                                {% endif %}


                                <div class="meta">

                                    {% if community.category %}

                                        <span class="tag">
                                            {{ community.category }}
                                        </span>

                                    {% endif %}

                                </div>


                                <div class="owner">

                                    👤 Created by

                                    {{ community.owner_name or "NijaWebbies member" }}

                                </div>


                                <div class="community-actions">

                                    {% if ns.joined %}

                                        <span class="btn btn-joined">
                                            ✓ Joined
                                        </span>

                                    {% else %}

                                        <form
                                            method="POST"
                                            action="{{ url_for('join_community', community_id=community.id) }}"
                                            style="margin:0;">

                                            <button
                                                type="submit"
                                                class="btn btn-join">
                                                Join Community
                                            </button>

                                        </form>

                                    {% endif %}

                                </div>

                            </article>

                        {% endfor %}

                    </div>

                {% else %}

                    <div class="empty">

                        <strong>
                            No communities have been created yet.
                        </strong>

                        <p>
                            Be the first person to create one.
                        </p>

                    </div>

                {% endif %}

            </div>

        </section>

    </div>

</main>


<footer>

    <div class="footer-inner">

        <div>

            <div class="footer-brand">
                🇳🇬 NijaWebbies
            </div>

            <div class="footer-text">
                Built for Nigeria & Africa.
            </div>

        </div>


        <div class="footer-links">

            <a href="{{ url_for('home') }}">
                Home
            </a>

            <a href="{{ url_for('search') }}">
                Search
            </a>

            <a href="{{ url_for('businesses') }}">
                Businesses
            </a>

            <a href="{{ url_for('communities') }}">
                Communities
            </a>

            <a href="{{ url_for('tools') }}">
                Free Tools
            </a>

            <a href="{{ url_for('workspace') }}">
                Workspace
            </a>

        </div>

    </div>

</footer>

</body>
</html>
